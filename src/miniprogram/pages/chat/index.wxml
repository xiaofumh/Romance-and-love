<view class="chat-shell">
  <view class="chat-heading"><text>{{mode === 'demo' ? '本地模拟 · 非真实模型' : '云端AI · 不是真人'}}</text><text bindtap="settings">会话设置 ···</text></view>
  <view class="initiative-note" wx:if="{{beijingTime}}">北京时间 {{beijingTime}} · {{mode === 'cloud' ? '服务器最近同步' : '本机演示时间'}}</view>
  <view class="demo-access" wx:if="{{mode === 'demo'}}"><view>当前只会生成固定模板，不是GLM回答。</view><button class="secondary" bindtap="realChat" disabled="{{busy || pendingText}}">使用真实AI聊天</button></view>
  <view class="chat-loading" wx:if="{{loading}}">正在加载会话…</view>
  <view class="demo-access" wx:if="{{contextResetReason}}">{{contextResetReason}}。当前上限{{contextRounds}}轮，新增消息重新累积；12轮按用户消息分组保留对应回复；纠错及隐私边界优先。</view>
  <view class="onboarding" wx:if="{{bootstrap && (!bootstrap.accepted || !bootstrap.settings.historyEnabled)}}"><view class="section-title">开始前，由你决定</view><view class="hint">这是AI聊天角色。需开启保存才能聊天，正文最近40条、最长30天。云端模式会把本轮消息、近期上下文及相关授权资料交给模型处理；其他数据去向请查看使用与隐私说明。</view><view class="consent-row" bindtap="agree"><text class="check">{{agreed ? '☑' : '○'}}</text>我已阅读使用与隐私说明</view><view class="consent-row" bindtap="agreeSave"><text class="check">{{saveAgreed ? '☑' : '○'}}</text>同意保存会话，可随时删除</view><view class="row"><button class="text-button" bindtap="legal">查看说明</button><button class="secondary" bindtap="enable">确认开启聊天</button></view></view>
  <scroll-view class="message-list" scroll-y scroll-into-view="{{bottom}}" scroll-with-animation>
    <view class="chat-intro"><view class="avatar">{{role.name}}</view><view>{{role.name || 'AI伙伴'}}</view><text>AI{{role.relationship === 'partner' ? '伴侣角色' : '朋友'}} · {{role.personality}}</text><view class="intro-note">{{role.description || '想说什么，都可以从这里开始。'}}</view></view>
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="message-row {{item.speaker === 'user' ? 'mine' : ''}}"><view class="chat-avatar">{{item.speaker === 'user' ? '我' : 'AI'}}</view><view class="message-content"><view class="bubble bubble-part" wx:for="{{item.displayParts}}" wx:for-item="part" wx:for-index="partIndex" wx:key="partIndex" data-id="{{item.id}}" bindlongpress="copy"><text user-select>{{part}}</text></view><view class="message-label" wx:if="{{item.speaker === 'assistant'}}">{{item.mode === 'demo' ? '模拟模板' : item.kind === 'initiative' ? 'AI主动接话' : 'AI生成'}}</view><button class="reference-toggle text-button" wx:if="{{item.sources.length}}" data-id="{{item.id}}" bindtap="toggleSources">参考资料 · {{item.sources.length}}条 {{expandedSources[item.id] ? '收起' : '展开'}}</button><view wx:if="{{expandedSources[item.id]}}"><view class="source-caption">{{item.referenceCaption}}</view><view class="source-link" wx:for="{{item.sources}}" wx:for-item="source" wx:key="turn" data-id="{{source.documentId}}" bindtap="source">{{source.title}} · 消息{{source.turn}} ›</view></view></view></view>
    <view class="message-row mine" wx:if="{{pendingText}}"><view class="chat-avatar">我</view><view class="bubble pending">{{pendingText}}<view class="tiny">{{busy ? '等待AI回复…' : '回复状态待确认'}}</view></view></view><view id="msg-end" class="chat-end"></view>
  </scroll-view>
  <view class="chat-error" wx:if="{{loadError || error}}">{{loadError || error}}<view wx:if="{{loadError}}" class="row"><button class="text-button" bindtap="load" disabled="{{loading || busy}}">重新加载会话</button><button class="text-button" bindtap="home">返回会话列表</button></view></view><view class="pending-actions" wx:if="{{!busy && (pendingText || lastJob.status === 'PROCESSING')}}"><button class="text-button" bindtap="query" disabled="{{busy || loading}}">查询原请求</button><button class="text-button" bindtap="discard" disabled="{{busy || lastJob.status === 'PROCESSING'}}">保留草稿，结束本次重试</button></view>
  <view class="initiative-note" wx:if="{{initiativeNote}}">{{initiativeNote}}</view>
  <view class="composer"><textarea class="chat-input" auto-height maxlength="1200" value="{{text}}" bindinput="input" placeholder="发消息…" /><button class="send-button" bindtap="send" disabled="{{busy || pendingText || initiativeBusy || loading || loadError || !bootstrap.enabled || !bootstrap.accepted || !bootstrap.settings.historyEnabled}}">{{busy ? '回复中' : '发送'}}</button></view>
</view>
