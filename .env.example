# 仅服务端配置。不要填写到小程序或聊天中。无配置时云端拒绝生成。
ASSISTANT_ENV=development
ASSISTANT_ENABLED=false
ASSISTANT_USER_HASH_SECRET=
# 默认保留外部审核依赖。仅内部测试可显式跳过，不是上线配置。
ASSISTANT_RELEASE_STAGE=production
CONTENT_REVIEW_MODE=tms
# 使用 internal-test 时，两项模式均须设 internal-test。
# 复制“我的”中本账号测试标识后填服务端，最多20个，逗号分隔；留空无人可生成。
INTERNAL_TEST_USER_IDS=
# 与你实际开通的国内模型服务一致；客户端不能覆盖。
MODEL_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
MODEL_API_KEY=
MODEL_NAME=glm-4.7
MODEL_JSON_MODE=true
# GLM短回复先关闭思考；default表示不发送该参数，供其他供应商兼容。
MODEL_THINKING=disabled
MODEL_TIMEOUT_MS=20000
# 腾讯文本内容安全：当前实现读取显式最小权限凭证；临时凭证需自行维护有效期。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SESSION_TOKEN=
TENCENT_REGION=ap-guangzhou
TMS_BIZ_TYPE=
# 服务端单日最多发起多少次外部模型调用（含失败，限制成本）；不是人民币实时预算。
DAILY_MODEL_CALL_LIMIT=100
# 每用户每日成功聊天上限；仍受全站调用预算约束，失败调用可能计费。
CHAT_DAILY_USER_LIMIT=100
# 仅 internal-test 且已在原白名单内的账号生效；不改变普通用户上限或访问权限。
INTERNAL_TEST_CHAT_DAILY_LIMIT=1000
PROVIDER_NAME=智谱 BigModel · GLM-4.7
OPERATOR_NAME=待填写实际运营主体
SUPPORT_CONTACT=待填写投诉联系渠道
