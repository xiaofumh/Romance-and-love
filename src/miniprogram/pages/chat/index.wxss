page{height:100%;background:#ededed}.chat-shell{height:100%;display:flex;flex-direction:column;color:#222}.chat-heading{display:flex;justify-content:space-between;padding:14rpx 26rpx;background:#e7e7e7;color:#777;font-size:21rpx}.message-list{flex:1;min-height:0;height:0}.chat-intro{text-align:center;color:#555;padding:42rpx 40rpx 26rpx;font-size:27rpx}.chat-intro .avatar{margin:0 auto 14rpx}.chat-intro text,.intro-note{font-size:22rpx;color:#999}.intro-note{margin-top:12rpx}.message-row{display:flex;gap:18rpx;margin:24rpx 24rpx;align-items:flex-start}.message-row.mine{flex-direction:row-reverse}.chat-avatar{width:72rpx;height:72rpx;background:#dbe9df;color:#43825f;line-height:72rpx;text-align:center;border-radius:10rpx;flex-shrink:0;font-size:25rpx}.mine .chat-avatar{background:#d7dee4;color:#617184}.message-content{max-width:76%}.bubble{padding:19rpx 23rpx;background:#fff;border-radius:10rpx;font-size:29rpx;line-height:1.65;word-break:break-word;white-space:pre-wrap;max-width:100%}.mine .bubble{background:#95ec69}.message-label{font-size:19rpx;color:#999;padding-top:6rpx}.source-link{font-size:20rpx;color:#63856c;margin-top:7rpx}.composer{display:flex;align-items:flex-end;gap:16rpx;background:#f7f7f7;border-top:1rpx solid #ddd;padding:18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom))}.chat-input{flex:1;min-height:74rpx;max-height:230rpx;background:white;border-radius:10rpx;padding:14rpx 18rpx;font-size:28rpx;line-height:44rpx}.send-button{background:#07b75f;color:white;padding:16rpx 26rpx;border-radius:10rpx;flex-shrink:0}.send-button[disabled]{background:#ddd;color:#999}.chat-error{color:#a95139;padding:10rpx 24rpx;font-size:23rpx;background:#fff4ed}.pending-actions{display:flex;justify-content:center;background:#f8f8f8}.pending{max-width:76%}.onboarding{margin:16rpx 20rpx;background:#fff;border-radius:16rpx;padding:22rpx;font-size:24rpx;max-height:48vh;overflow-y:auto}.onboarding .hint{font-size:22rpx}.chat-end{height:26rpx}
.chat-input{min-width:0}.send-button{flex:0 0 140rpx;min-width:140rpx;max-width:140rpx}.chat-intro .avatar{font-size:24rpx}
.chat-loading{padding:12rpx 24rpx;color:#888;font-size:22rpx;text-align:center}
.demo-access{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:16rpx 24rpx;background:#fff5e8;font-size:22rpx;color:#8b6b3f}.demo-access .secondary{font-size:23rpx;padding:12rpx 16rpx;flex-shrink:0}.reference-toggle{padding:4rpx 0;font-size:20rpx;text-align:left}.source-caption{color:#888;font-size:20rpx;margin-top:8rpx}
.bubble-part + .bubble-part{margin-top:12rpx}.initiative-note{padding:10rpx 24rpx;font-size:22rpx;color:#737d75;background:#f2f6f2}
